{
  "name": "n8n-nodes-rule-evaluator",
  "version": "1.2.0",
  "description": "Custom n8n node for evaluating business rules and policies",
  "main": "dist/nodes/RuleEvaluator/RuleEvaluator.node.js",
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/copy-icons.mjs",
    "dev": "tsc --watch",
    "format": "prettier nodes/**/*.ts lib/**/*.ts tests/**/*.mjs --write",
    "format:check": "prettier --check nodes/**/*.ts lib/**/*.ts tests/**/*.mjs package.json",
    "check:scope": "node scripts/scope-guard.mjs",
    "lint": "eslint nodes/**/*.ts tests/**/*.mjs scripts/**/*.mjs",
    "lint:n8n": "n8n-node lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:scope && npm run lint && npm run typecheck && npm run format:check && npm run lint:n8n && npm test",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "keywords": [
    "n8n-community-node-package",
    "rules",
    "decision",
    "evaluator"
  ],
  "author": {
    "name": "Andrey Toropchin",
    "email": "a.s.toropchin@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atoropchin/n8n-nodes-rule-evaluator.git"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "files": [
    "dist/**/*",
    "README.md",
    "docs/README.ru.md",
    "docs/README.es.md",
    "docs/README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "dist/nodes/RuleEvaluator/RuleEvaluator.node.js",
      "dist/nodes/BusinessRules/BusinessRules.node.js",
      "dist/nodes/DecisionTable/DecisionTable.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@n8n/node-cli": "^0.17.2",
    "eslint": "^10.3.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  }
}
